{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "ignoreCase": true,
    "sortSideEffects": true,
    "customGroups": [
      {
        "groupName": "framework",
        "elementNamePattern": ["react", "react-dom", "react-dom/**"]
      },
      {
        "groupName": "styles",
        "elementNamePattern": ["**/*.css"]
      },
      {
        "groupName": "assets",
        "elementNamePattern": [
          "**/assets/**",
          "**/locales/**",
          "**/*.svg",
          "**/*.png",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.gif",
          "**/*.webp"
        ]
      },
      {
        "groupName": "components",
        "elementNamePattern": [
          "**/routes",
          "**/routes/**",
          "**/components",
          "**/components/**",
          "**/routes",
          "**/routes/**",
          "**/pages",
          "**/pages/**",
          "**/App",
          "**/App.tsx"
        ]
      },
      {
        "groupName": "modules",
        "elementNamePattern": ["./**", "../**"]
      }
    ],
    "groups": [
      "framework",
      ["value-builtin", "value-external"],
      "modules",
      "components",
      "styles",
      "assets",
      "unknown"
    ]
  }
}
